# 鲜果记后端环境变量模板
# 复制为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交

SERVER_HOST=127.0.0.1
SERVER_PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
REDIS_PASSWORD=your_redis_password
DRUID_USER=druid
DRUID_PASSWORD=your_druid_password
JWT_SECRET=your_jwt_secret_at_least_32_bytes
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# 阿里云 OSS（文件上传存储）
ALIYUN_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=your_oss_access_key_id
ALIYUN_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
ALIYUN_OSS_BUCKET=your_oss_bucket
